    "NSMotionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bewegungserlaubnis hilft dabei, zu erkennen, wann sich das Gerät bewegt, um die Tracking-Effizienz, Genauigkeit und die allgemeine App-Leistung zu verbessern. Dies ermöglicht ein korrektes Funktionieren des Trackings während der Bestellung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion permission helps detect when the device is in motion to improve tracking efficiency, accuracy, and overall app performance. This allows tracking to function properly while the order is being completed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El permiso de movimiento ayuda a detectar cuándo el dispositivo está en movimiento para mejorar la eficiencia del seguimiento, la precisión y el rendimiento general de la aplicación. Esto permite que el seguimiento funcione correctamente mientras se completa el pedido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'autorisation de mouvement aide à détecter quand l'appareil est en mouvement pour améliorer l'efficacité du suivi, la précision et les performances globales de l'application. Cela permet au suivi de fonctionner correctement pendant la réalisation de la commande."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App benötigt Zugriff auf die Fotomediathek für das Profilbild und zum Hochladen von Bildern zur Kommunikation über die Nachrichtenfunktionen der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app requires access to the photo library for the profile picture, to upload images to communicate via the messaging features of the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación requiere acceso a la fototeca para la foto de perfil y para cargar imágenes para comunicarse a través de las funciones de mensajería de la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application nécessite l'accès à la galerie photos pour la photo de profil et pour télécharger des images afin de communiquer via les fonctionnalités de messagerie de l'application."
